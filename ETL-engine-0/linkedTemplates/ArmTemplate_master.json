{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ETL-engine-0"
		},
		"blob_storage_1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'blob_storage_1'"
		},
		"sql_db_0_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sql_db_0'"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.openweathermap.org/"
		},
		"RestService1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.openweathermap.org/data/2.5/weather?lat=-37.310663&lon=-59.112763&appid=f63e8d24da2afca5c6c6c1f3b73f077c&units=metric&lang=es"
		},
		"sql_db_0_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "db-server-0.database.windows.net"
		},
		"sql_db_0_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_0"
		},
		"sql_db_0_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CloudSAc12b48ee"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ETL-engine-0_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"blob_storage_1_connectionString": {
						"value": "[parameters('blob_storage_1_connectionString')]"
					},
					"sql_db_0_password": {
						"value": "[parameters('sql_db_0_password')]"
					},
					"HttpServer1_properties_typeProperties_url": {
						"value": "[parameters('HttpServer1_properties_typeProperties_url')]"
					},
					"RestService1_properties_typeProperties_url": {
						"value": "[parameters('RestService1_properties_typeProperties_url')]"
					},
					"sql_db_0_properties_typeProperties_server": {
						"value": "[parameters('sql_db_0_properties_typeProperties_server')]"
					},
					"sql_db_0_properties_typeProperties_database": {
						"value": "[parameters('sql_db_0_properties_typeProperties_database')]"
					},
					"sql_db_0_properties_typeProperties_userName": {
						"value": "[parameters('sql_db_0_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}